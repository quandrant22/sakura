# ──────────────────────────────────────────────────────────────
# Sakura Агент (ПК / ноутбук) — пример переменных окружения
# Скопируй в .env и заполни. Секреты (WS_TOKEN, токены) не коммить.
# ──────────────────────────────────────────────────────────────

# Подключение к серверу: ws://host:8765 или wss:// после настройки TLS
VPS_WS_URL=wss://your.domain.com/ws

# Имя этого устройства — должно быть добавлено на сервере
DEVICE_ID=laptop

# Токен сервера (обязателен: без него агент не подключается)
WS_TOKEN=

# ID браузерного расширения (пусто — любое расширение)
SAKURA_EXTENSION_ID=
# Порты локального сервера расширения
EXTENSION_PORTS=8766,8767,8768,8769

# Распознавание: GigaAM (Vosk small — только слово «Сакура»)
STT_ENGINE=gigaam
GIGAAM_MODEL=v3_e2e_ctc
# запасная модель: GIGAAM_MODEL=v2_ctc
GIGAAM_DEVICE=cpu
VOSK_STT_MODEL=vosk-model-small-ru-0.22

# Устройство вывода звука (default или номер/часть имени)
AUDIO_OUTPUT_DEVICE=default

# Яндекс Музыка (по желанию)
YANDEX_MUSIC_TOKEN=

# Шаг «громче/тише» для музыки без числа, % (по умолчанию 10)
# VOLUME_STEP=10

# Конец фразы по тишине, сек: обычный задан в config.py (VAD_END_SILENCE=1.0);
# короткая фраза (речь < VAD_SHORT_UTTER_SEC) — по VAD_END_SILENCE_SHORT
# VAD_END_SILENCE_SHORT=0.7
# VAD_SHORT_UTTER_SEC=1.5

# Предзаполнение плеера озвучки, мс (0 — выключено)
# PLAYER_PREROLL_MS=0

# Не используются (остатки Yandex SpeechKit):
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
