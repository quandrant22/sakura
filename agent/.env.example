# ──────────────────────────────────────────────────────────────
# Sakura Агент (ПК / ноутбук) — пример переменных окружения
# Скопируй в .env и заполни реальными значениями.
# ──────────────────────────────────────────────────────────────

# Подключение к VPS
# wss:// — после настройки Caddy/nginx с TLS
# ws://  — только для локальной разработки без TLS
VPS_WS_URL=wss://your.domain.com/ws

# Идентификатор этого устройства (laptop / pc / phone)
DEVICE_ID=laptop

# Токен авторизации — должен совпадать с WS_SECRET на VPS
# Генерация: python generate_token.py
WS_TOKEN=replace_with_same_value_as_vps_WS_SECRET

# Ограничение браузерного расширения (пусто — любое Chrome extension origin)
SAKURA_EXTENSION_ID=

# Шаг «громче/тише» для музыки без числа, % (по умолчанию 10)
# VOLUME_STEP=10

# Конец короткой фразы (речь < VAD_SHORT_UTTER_SEC) — по тишине VAD_END_SILENCE_SHORT, сек
# VAD_END_SILENCE_SHORT=0.7
# VAD_SHORT_UTTER_SEC=1.5

# Предзаполнение плеера озвучки, мс (0 — выключено)
# PLAYER_PREROLL_MS=0

# Оверлей: при «уходе» фокуса на другое устройство гасить окно не ниже этой
# прозрачности (1.0 — не затемнять), и только если ввода не было столько секунд
# OVERLAY_DEPARTURE_OPACITY=0.7
# OVERLAY_DEPART_IDLE_S=120
# Непрозрачность фона панели оверлея, 0..255
# OVERLAY_PANEL_ALPHA=235

# Yandex SpeechKit (TTS)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
