{
  "sakura-husk": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "python agy_hook.py pre_tool"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "python agy_hook.py post_tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "command": "python agy_hook.py stop"
      }
    ]
  }
}
