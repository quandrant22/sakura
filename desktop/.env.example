# Sakura desktop — переменные окружения ядра (desktop/core/config.py).
# Ядро читает .env так: SAKURA_ENV_FILE → desktop/.env → agent/.env.
# Секреты (WS_TOKEN, YANDEX_MUSIC_TOKEN) вписываются только в .env, не сюда.

DEVICE_ID=
VPS_WS_URL=
WS_TOKEN=
SAKURA_EXTENSION_ID=

# Данные ядра (медиатека, кэши, логи); по умолчанию %LOCALAPPDATA%\Sakura
# SAKURA_DATA_DIR=

# ── Медиа (desktop/docs/media.md) ─────────────────────────────────
# Папки по умолчанию, через «;» (в интерфейсе: Настройки → Медиа)
# MUSIC_FOLDERS=C:\Users\me\Music
# VIDEO_FOLDERS=C:\Users\me\Videos
# Плавный переход между треками, секунды (0 — выключено)
# CROSSFADE_S=0
# Громкость встроенных плееров, пока Сакура слушает/говорит, %
# PLAYER_DUCK_PCT=30
# YouTube: embedded — встроенный плеер, remote — вкладка браузера
# YOUTUBE_MODE=embedded
# Прокси только для плеера YouTube (desktop/docs/network.md)
# YOUTUBE_PROXY=
# Яндекс.Музыка во встроенном плеере (неофициальный доступ), нужен YANDEX_MUSIC_TOKEN
# MUSIC_YANDEX=0
# YANDEX_MUSIC_TOKEN=
