(* securechannel/1 — сеанс Noise_IK_25519_ChaChaPoly_BLAKE2s (PROTOCOL.md §3.1–3.2).
   Символьная модель для ProVerif ≥ 2.04. Запуск — results/README.md.
   Статус: ОЖИДАЕТ ЗАПУСКА (на VPS ProVerif не запускается, см. FORMAL.md).

   Примитивы:
     DH   — exp(gen, x) = открытый ключ, exp(P, x) = DH(x, P);
            уравнение exp(exp(gen,x),y) = exp(exp(gen,y),x) (как в руководстве ProVerif);
     HASH — hash; HKDF — три независимые проекции hkdf1/hkdf2/hkdf3 (выходы 1–3);
     AEAD — aenc(k, n, ad, m) / adec, nonce символьный (n0 = 0, n1 = 1).
   Порядок токенов, MixHash/MixKey, AD = h и nonce — буквально по спецификации
   Noise и securechannel/noise/core.py:
     h = HASH(имя протокола) (имя 33 байта > HASHLEN), ck = h,
     MixHash(prologue_session), пред-сообщение <- s: MixHash(rs);
     -> e, es, s, ss + payload (идентификация, публична);
     <- e, ee, se + payload (параметры сеанса, публичны);
     Split(): kIR = hkdf1(ck, ε) — клиент → сервер, kRI = hkdf2(ck, ε) — обратно;
     транспорт: AD пустой (handshake._edu_cipher, noiseprotocol).

   Участники:
     C  — честное устройство (skC), зарегистрировано у S и у K;
     S  — честный сервер (skS);
     K  — сервер со СКОМПРОМЕТИРОВАННЫМ ключом (skK публичен) — сценарий KCI;
     D  — устройство атакующего, зарегистрированное у S (skD публичен);
     фаза 1 — утечка skS и skC после всех сеансов (прямая секретность).
   Реестр — таблица registry(pub сервера, pub устройства); не нашёл — молчание.

   Запросы и ОЖИДАЕМЫЙ результат (C = exp(gen,skC), S = exp(gen,skS), K = exp(gen,skK)):
     Q1  attacker(payload_c)                                         true   G1, с фазой 1 = G6
     Q2  attacker(payload_s)                                         true   G1, G6
     Q3  inj ServerDone(C,S,..)    ==> inj ClientStarted(C,S,e1)     true   G3
     Q4  inj ServerDone(C,S,..)    ==> inj ClientDone(C,S,..)        true   G3, согласие о ключе
     Q5  inj ClientDone(C,S,..)    ==> inj ServerAccepted(C,S,..)    true   G4
     Q6      ServerAccepted(C,S,..) ==>    ClientStarted(C,S,e1)     true   сообщение 1 подлинно
     Q7  inj ServerAccepted(C,S,..) ==> inj ClientStarted(C,S,e1)    FALSE  ожидаемая атака ПОВТОРА IK_INIT
     Q8      ServerAccepted(C,K,..) ==>    ClientStarted(C,K,e1)     FALSE  ожидаемая атака KCI на сообщение 1
     Q9      ServerDone(C,K,..)     ==>    ClientStarted(C,K,e1)     true   KCI не идёт дальше сообщения 1
     Q10 event(ServerDone(C,S,..))                                   FALSE  проверка достижимости (не пустая модель)
   Q7 и Q8 подтверждают правило §3.2: сервер ПРИНИМАЕТ сообщение 1 от
   повтора и (при утечке своего ключа) от подделки, поэтому payload IK_INIT —
   только идентификация, а всё исполняемое — после ServerDone (транспорт). *)

type key.

const gen: bitstring [data].
fun exp(bitstring, key): bitstring.
equation forall x: key, y: key; exp(exp(gen, x), y) = exp(exp(gen, y), x).

fun hash(bitstring): bitstring.
fun hkdf1(bitstring, bitstring): bitstring.
fun hkdf2(bitstring, bitstring): bitstring.
fun hkdf3(bitstring, bitstring): bitstring.

fun aenc(bitstring, bitstring, bitstring, bitstring): bitstring.
reduc forall k: bitstring, n: bitstring, ad: bitstring, m: bitstring;
  adec(k, n, ad, aenc(k, n, ad, m)) = m.

free c: channel.

const name_ik: bitstring.            (* "Noise_IK_25519_ChaChaPoly_BLAKE2s" *)
const prologue_session: bitstring.   (* b"sakura-securechannel/1\x00session" *)
const empty: bitstring.
const n0: bitstring.
const n1: bitstring.
const ident_c: bitstring.            (* {"v":1,"device_id","ts"} — публично *)
const params_s: bitstring.           (* {"v":1,"session","rekey_*","server_time"} — публично *)
const pub_c: bitstring.              (* транспорт в сеансах с K — не секрет *)
const pub_s: bitstring.

free skS: key [private].
free skC: key [private].
free skK: key.                        (* ключ K скомпрометирован *)
free skD: key.                        (* устройство атакующего *)

free payload_c: bitstring [private].  (* транспорт C → S *)
free payload_s: bitstring [private].  (* транспорт S → C *)

table registry(bitstring, bitstring).

event ClientStarted(bitstring, bitstring, bitstring).                          (* C, S, e_C *)
event ServerAccepted(bitstring, bitstring, bitstring, bitstring).              (* C, S, e_C, e_S *)
event ClientDone(bitstring, bitstring, bitstring, bitstring, bitstring).       (* C, S, e_C, e_S, kIR *)
event ServerDone(bitstring, bitstring, bitstring, bitstring, bitstring).

query attacker(payload_c).
query attacker(payload_s).
query e1: bitstring, e2: bitstring, k: bitstring;
  inj-event(ServerDone(exp(gen, skC), exp(gen, skS), e1, e2, k))
  ==> inj-event(ClientStarted(exp(gen, skC), exp(gen, skS), e1)).
query e1: bitstring, e2: bitstring, k: bitstring;
  inj-event(ServerDone(exp(gen, skC), exp(gen, skS), e1, e2, k))
  ==> inj-event(ClientDone(exp(gen, skC), exp(gen, skS), e1, e2, k)).
query e1: bitstring, e2: bitstring, k: bitstring;
  inj-event(ClientDone(exp(gen, skC), exp(gen, skS), e1, e2, k))
  ==> inj-event(ServerAccepted(exp(gen, skC), exp(gen, skS), e1, e2)).
query e1: bitstring, e2: bitstring;
  event(ServerAccepted(exp(gen, skC), exp(gen, skS), e1, e2))
  ==> event(ClientStarted(exp(gen, skC), exp(gen, skS), e1)).
query e1: bitstring, e2: bitstring;
  inj-event(ServerAccepted(exp(gen, skC), exp(gen, skS), e1, e2))
  ==> inj-event(ClientStarted(exp(gen, skC), exp(gen, skS), e1)).
query e1: bitstring, e2: bitstring;
  event(ServerAccepted(exp(gen, skC), exp(gen, skK), e1, e2))
  ==> event(ClientStarted(exp(gen, skC), exp(gen, skK), e1)).
query e1: bitstring, e2: bitstring, k: bitstring;
  event(ServerDone(exp(gen, skC), exp(gen, skK), e1, e2, k))
  ==> event(ClientStarted(exp(gen, skC), exp(gen, skK), e1)).
query e1: bitstring, e2: bitstring, k: bitstring;
  event(ServerDone(exp(gen, skC), exp(gen, skS), e1, e2, k)).

(* Инициатор (устройство). pkR — ключ сервера, известный из спаривания. *)
let Client(skI: key, pkR: bitstring, msg: bitstring) =
  new eI: key;
  let pkI = exp(gen, skI) in
  let eIPub = exp(gen, eI) in
  event ClientStarted(pkI, pkR, eIPub);
  let h0 = hash(name_ik) in
  let ck0 = h0 in
  let h1 = hash((h0, prologue_session)) in
  let h2 = hash((h1, pkR)) in                       (* <- s *)
  (* IK_INIT: -> e, es, s, ss *)
  let h3 = hash((h2, eIPub)) in                     (* e *)
  let ck1 = hkdf1(ck0, exp(pkR, eI)) in             (* es *)
  let k1 = hkdf2(ck0, exp(pkR, eI)) in
  let cS = aenc(k1, n0, h3, pkI) in                 (* s *)
  let h4 = hash((h3, cS)) in
  let ck2 = hkdf1(ck1, exp(pkR, skI)) in            (* ss *)
  let k2 = hkdf2(ck1, exp(pkR, skI)) in
  let cP1 = aenc(k2, n0, h4, ident_c) in            (* payload: только идентификация *)
  let h5 = hash((h4, cP1)) in
  out(c, (eIPub, cS, cP1));
  (* IK_RESP: <- e, ee, se *)
  in(c, (eR: bitstring, cP2: bitstring));
  let h6 = hash((h5, eR)) in                        (* e *)
  let ck3 = hkdf1(ck2, exp(eR, eI)) in              (* ee *)
  let ck4 = hkdf1(ck3, exp(eR, skI)) in             (* se = DH(s_I, e_R) *)
  let k4 = hkdf2(ck3, exp(eR, skI)) in
  let p2 = adec(k4, n0, h6, cP2) in
  let kIR = hkdf1(ck4, empty) in                    (* Split *)
  let kRI = hkdf2(ck4, empty) in
  event ClientDone(pkI, pkR, eIPub, eR, kIR);
  out(c, aenc(kIR, n0, empty, msg));
  in(c, t: bitstring);
  let reply = adec(kRI, n0, empty, t) in 0.

(* Ответчик (сервер). msgC — что отправить устройству C (другим — pub_s). *)
let Server(skR: key, msgC: bitstring) =
  let pkR = exp(gen, skR) in
  in(c, (eI: bitstring, cS: bitstring, cP1: bitstring));
  let h0 = hash(name_ik) in
  let ck0 = h0 in
  let h1 = hash((h0, prologue_session)) in
  let h2 = hash((h1, pkR)) in
  let h3 = hash((h2, eI)) in
  let ck1 = hkdf1(ck0, exp(eI, skR)) in             (* es = DH(s_R, e_I) *)
  let k1 = hkdf2(ck0, exp(eI, skR)) in
  let sI = adec(k1, n0, h3, cS) in
  let h4 = hash((h3, cS)) in
  get registry(=pkR, =sI) in                        (* нет в реестре — молчание *)
  let ck2 = hkdf1(ck1, exp(sI, skR)) in             (* ss *)
  let k2 = hkdf2(ck1, exp(sI, skR)) in
  let ident = adec(k2, n0, h4, cP1) in
  let h5 = hash((h4, cP1)) in
  new eR: key;
  let eRPub = exp(gen, eR) in
  event ServerAccepted(sI, pkR, eI, eRPub);
  let h6 = hash((h5, eRPub)) in                     (* e *)
  let ck3 = hkdf1(ck2, exp(eI, eR)) in              (* ee *)
  let ck4 = hkdf1(ck3, exp(sI, eR)) in              (* se = DH(e_R, s_I) *)
  let k4 = hkdf2(ck3, exp(sI, eR)) in
  out(c, (eRPub, aenc(k4, n0, h6, params_s)));
  let kIR = hkdf1(ck4, empty) in
  let kRI = hkdf2(ck4, empty) in
  in(c, t: bitstring);
  let m = adec(kIR, n0, empty, t) in                (* первый транспортный кадр устройства *)
  event ServerDone(sI, pkR, eI, eRPub, kIR);
  if sI = exp(gen, skC) then
    out(c, aenc(kRI, n0, empty, msgC))
  else
    out(c, aenc(kRI, n0, empty, pub_s)).

process
  insert registry(exp(gen, skS), exp(gen, skC));
  insert registry(exp(gen, skS), exp(gen, skD));
  insert registry(exp(gen, skK), exp(gen, skC));
  out(c, (exp(gen, skS), exp(gen, skC)));
  (
      (!Client(skC, exp(gen, skS), payload_c))
    | (!Client(skC, exp(gen, skK), pub_c))
    | (!Server(skS, payload_s))
    | (!Server(skK, pub_s))
    | (phase 1; out(c, (skS, skC)))
  )
