<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/sakuraBg"
    android:orientation="vertical">

    <TextView
        style="@style/Sakura.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/edge"
        android:text="Память" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/edge"
        android:paddingEnd="@dimen/edge"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/edge"
        android:paddingEnd="@dimen/edge">

        <EditText
            android:id="@+id/query"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch"
            android:layout_weight="1"
            android:background="@drawable/bg_panel2"
            android:hint="Поиск по памяти"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="?attr/sakuraInk"
            android:textColorHint="?attr/sakuraInkDim" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search"
            style="@style/Widget.Sakura.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_small"
            android:text="Найти" />
    </LinearLayout>

    <TextView
        android:id="@+id/note"
        style="@style/Sakura.Dim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/edge"
        android:paddingEnd="@dimen/edge"
        android:textColor="?attr/sakuraWarn"
        android:visibility="gone" />

    <app.sakura.mobile.ui.common.StateView
        android:id="@+id/state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/edge" />
        </ScrollView>
    </app.sakura.mobile.ui.common.StateView>
</LinearLayout>
