<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/sakuraBg"
    android:orientation="vertical">

    <TextView
        style="@style/Sakura.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/edge"
        android:text="Сводка" />

    <app.sakura.mobile.ui.common.StateView
        android:id="@+id/state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/edge"
                android:paddingEnd="@dimen/edge"
                android:paddingBottom="@dimen/edge">

                <LinearLayout
                    style="@style/Sakura.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/status_mode"
                        style="@style/Sakura.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/status_quote"
                        style="@style/Sakura.Dim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    style="@style/Sakura.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Устройства" />

                <LinearLayout
                    android:id="@+id/devices"
                    style="@style/Sakura.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Sakura.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Сценарии" />

                <LinearLayout
                    android:id="@+id/events"
                    style="@style/Sakura.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Sakura.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Последние ответы Сакуры" />

                <LinearLayout
                    android:id="@+id/replies"
                    style="@style/Sakura.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </app.sakura.mobile.ui.common.StateView>
</LinearLayout>
